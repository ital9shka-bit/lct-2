APP_ENV=demo
APP_ORIGIN=http://localhost:8088
APP_PORT=8088
MAILPIT_PORT=8089
APP_SECRET=replace-with-a-random-string-at-least-32-characters
POSTGRES_PASSWORD=replace-with-random-postgres-password
AUTH_MODE=email
DEMO_PUBLIC=false
TRUST_PROXY=false
# Для docker compose -f compose.yaml -f compose.keycloak.yaml:
OIDC_ISSUER=
OIDC_INTERNAL_ISSUER=
OIDC_CLIENT_ID=oop-web
OIDC_CLIENT_SECRET=
KEYCLOAK_HOSTNAME=http://localhost:8090/sso
KEYCLOAK_PORT=8090
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REVIEWER_PASSWORD=
LLM_MODE=manual
# Для ИИ: remote; URL — база /v1 или полный /chat/completions.
# Например: https://gatellm.ru/v1, модель openai/gpt-6-luna.
# Ключ хранить только в .env; импорт PDF отправляет текст после выбора пользователя.
LLM_URL=
LLM_API_KEY=
LLM_MODEL=
SMTP_HOST=mailpit
SMTP_PORT=1025
